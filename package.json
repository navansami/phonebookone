{
  "name": "phonebookone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/generate-sw-manifest.mjs",
    "start": "next start --hostname 127.0.0.1",
    "setup": "node scripts/setup.mjs",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "seed:fmc": "node --env-file=.env.local scripts/seed-fmc.mjs",
    "migrate:local": "node --env-file=.env.local scripts/migrate-local.mjs",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.14",
    "axios": "^1.7.9",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "mongodb": "^7.7.0",
    "next": "^15.5.12",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.4.1",
    "react-image-crop": "^11.0.10",
    "react-router-dom": "^7.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.12",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
